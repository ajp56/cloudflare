{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nome do Worker (aparece no endereço *.workers.dev). Tem de ser IGUAL ao nome do projeto criado no Cloudflare.
  "name": "imopreferencial",
  "main": "src/index.js",
  "compatibility_date": "2026-04-03",
  // Mantém no Cloudflare as definições que lá forem feitas (os segredos nunca são tocados).
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Só estes caminhos passam primeiro pelo código; o resto é servido como ficheiros.
    "run_worker_first": ["/api/*", "/admin"]
  },
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "441a7182b96f45d58816cdfd4fdec01a" }
  ]
}
